{
  "openapi": "3.0.3",
  "info": {
    "title": "Agent Service API",
    "description": "AI Agent service with conversation management and streaming",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "tags": ["health"],
        "description": "Health check endpoint",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "timestamp"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "Health status"
                    },
                    "timestamp": {
                      "type": "string",
                      "description": "Current timestamp"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conversations": {
      "post": {
        "operationId": "createConversation",
        "tags": ["conversations"],
        "description": "Create a new conversation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Conversation title"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "userId", "createdAt", "updatedAt"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Conversation ID (UUID)"
                    },
                    "userId": {
                      "type": "string",
                      "description": "User ID"
                    },
                    "title": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "createdAt": {
                      "type": "string",
                      "description": "Creation timestamp (ISO 8601)"
                    },
                    "updatedAt": {
                      "type": "string",
                      "description": "Last update timestamp (ISO 8601)"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listConversations",
        "tags": ["conversations"],
        "description": "List conversations for the authenticated user",
        "parameters": [
          {
            "schema": {
              "type": "number",
              "default": 50
            },
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Maximum results"
          },
          {
            "schema": {
              "type": "number",
              "default": 0
            },
            "in": "query",
            "name": "offset",
            "required": false,
            "description": "Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["conversations", "total"],
                  "properties": {
                    "conversations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "userId", "createdAt", "updatedAt"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Conversation ID (UUID)"
                          },
                          "userId": {
                            "type": "string",
                            "description": "User ID"
                          },
                          "title": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "createdAt": {
                            "type": "string",
                            "description": "Creation timestamp (ISO 8601)"
                          },
                          "updatedAt": {
                            "type": "string",
                            "description": "Last update timestamp (ISO 8601)"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "number",
                      "description": "Total count"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{id}": {
      "get": {
        "operationId": "getConversation",
        "tags": ["conversations"],
        "description": "Get a conversation with its messages",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Conversation ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "userId",
                    "createdAt",
                    "updatedAt",
                    "messages"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Conversation ID (UUID)"
                    },
                    "userId": {
                      "type": "string",
                      "description": "User ID"
                    },
                    "title": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "createdAt": {
                      "type": "string",
                      "description": "Creation timestamp (ISO 8601)"
                    },
                    "updatedAt": {
                      "type": "string",
                      "description": "Last update timestamp (ISO 8601)"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "conversationId",
                          "role",
                          "content",
                          "createdAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Message ID (UUID)"
                          },
                          "conversationId": {
                            "type": "string",
                            "description": "Conversation ID"
                          },
                          "role": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": ["user"]
                              },
                              {
                                "type": "string",
                                "enum": ["assistant"]
                              },
                              {
                                "type": "string",
                                "enum": ["tool"]
                              }
                            ]
                          },
                          "content": {
                            "type": "string",
                            "description": "Message content"
                          },
                          "toolCalls": {
                            "description": "Tool calls made"
                          },
                          "toolResults": {
                            "description": "Tool results"
                          },
                          "model": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "inputTokens": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "outputTokens": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "createdAt": {
                            "type": "string",
                            "description": "Creation timestamp (ISO 8601)"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateConversation",
        "tags": ["conversations"],
        "description": "Update a conversation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Conversation title"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Conversation ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "userId", "createdAt", "updatedAt"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Conversation ID (UUID)"
                    },
                    "userId": {
                      "type": "string",
                      "description": "User ID"
                    },
                    "title": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "createdAt": {
                      "type": "string",
                      "description": "Creation timestamp (ISO 8601)"
                    },
                    "updatedAt": {
                      "type": "string",
                      "description": "Last update timestamp (ISO 8601)"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteConversation",
        "tags": ["conversations"],
        "description": "Delete a conversation",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Conversation ID"
          }
        ],
        "responses": {
          "204": {
            "description": "Default Response"
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{id}/chat": {
      "post": {
        "operationId": "chat",
        "tags": ["chat"],
        "description": "Send a message and stream the agent response via Server-Sent Events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "User message to send"
                  }
                }
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Conversation ID"
          }
        ],
        "responses": {
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3003",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Health check endpoints"
    },
    {
      "name": "conversations",
      "description": "Conversation management"
    },
    {
      "name": "chat",
      "description": "Chat with the AI agent"
    }
  ]
}
