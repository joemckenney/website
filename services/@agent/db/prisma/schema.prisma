generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  title     String?
  sessionId String?   // Agent SDK session ID for multi-turn conversations
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String      @db.Text

  // Tool-related fields (nullable for non-tool messages)
  toolCalls   Json? // Array of {id, name, arguments} for assistant tool_use
  toolResults Json? // Array of {toolCallId, result, isError} for tool results

  // Metadata
  model        String?
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime @default(now())

  @@index([conversationId])
}

enum MessageRole {
  user
  assistant
  tool
}
