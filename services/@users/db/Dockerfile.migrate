# Prisma 7.x migration runner for Kubernetes Jobs
FROM node:22-alpine

WORKDIR /app

# Install dependencies required by prisma.config.ts
RUN npm install -g prisma@7.2.0 && \
    npm install @prisma/adapter-pg@7.2.0 pg@8.14.1

# Copy prisma config (required for Prisma 7.x - contains datasource.url)
COPY services/@users/db/prisma.config.ts ./

# Copy prisma schema and migrations
COPY services/@users/db/prisma ./prisma

# Default command runs migrations
# DATABASE_URL must be set via environment variable
CMD ["prisma", "migrate", "deploy"]
