{
  "name": "@gateway/service",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsgo && tsx src/generate-spec.ts",
    "build:docker": "REPO_ROOT=$(git rev-parse --show-toplevel) && eval $(minikube docker-env) && docker buildx build -t localhost:5000/api-service:latest -f Dockerfile $REPO_ROOT",
    "build:docker:local": "REPO_ROOT=$(git rev-parse --show-toplevel) && eval $(minikube docker-env) && docker buildx build -t localhost:5000/api-service:latest -f Dockerfile $REPO_ROOT",
    "build:docker:prod": "REPO_ROOT=$(git rev-parse --show-toplevel) && docker build -t ${DOCKERHUB_USERNAME}/api-service:${TAG:-latest} -f Dockerfile $REPO_ROOT",
    "deploy:helm:local": "helm upgrade --install api-service ./helm -f ./helm/values-local.yaml --wait --timeout=5m",
    "deploy:helm:prod": "helm upgrade --install api-service ./helm -f ./helm/values-prod.yaml --wait --timeout=5m",
    "clean": "rm -rf dist",
    "clean:docker": "docker rmi localhost:5000/api-service:latest || true",
    "start": "node dist/index.js",
    "check": "biome check .",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.6.0",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@users/sdk": "workspace:*",
    "typebox": "^1.0.13",
    "arctic": "^3.7.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-metrics": "^12.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@typescript/native-preview": "catalog:",
    "@website/config": "workspace:*",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.16.2"
  }
}
