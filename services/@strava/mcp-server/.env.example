# Strava OAuth credentials (get from https://www.strava.com/settings/api)
#
# IMPORTANT: Strava only allows ONE callback domain per app.
# Use a single Strava app with prod callback domain (api.joemckenney.com).
# The OAuth flow uses the `env` query parameter to route redirects back to
# the correct frontend after token exchange:
#   - local:    http://localhost:5173
#   - minikube: http://app.local.com
#   - prod:     https://app.joemckenney.com
#
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
# This goes through the gateway, not directly to this service
# For prod: https://api.joemckenney.com/strava/auth/callback
STRAVA_REDIRECT_URI=http://localhost:3000/strava/auth/callback

# Database URL (shared with agent-db)
DATABASE_URL=postgresql://agent:devpassword@localhost:5433/agent

# 32-byte hex encryption key for storing tokens
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend URL for OAuth redirects (fallback if env not specified)
# The env-specific URLs are hardcoded in config.ts for security
FRONTEND_URL=http://localhost:5173

# Port
PORT=3004
