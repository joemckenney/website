{
  "name": "@weather/sdk",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "pnpm run build && chokidar '../spec/openapi.json' -c 'pnpm run build'",
    "build": "openapi-ts && tsgo",
    "clean": "rm -rf dist src/generated",
    "check": "biome check .",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@hey-api/client-fetch": "^0.7.1",
    "@hey-api/openapi-ts": "^0.87.2",
    "@typescript/native-preview": "catalog:",
    "@weather/spec": "workspace:*",
    "@website/config": "workspace:*",
    "chokidar-cli": "^3.0.0"
  }
}
