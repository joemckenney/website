# Production values for app-server (api.joemckenney.com)
# Copy this to values-prod.yaml and fill in your production secrets
replicaCount: 2

image:
  repository: YOUR_DOCKERHUB_USERNAME/app-server
  pullPolicy: IfNotPresent
  tag: "latest"

imagePullSecrets: []

service:
  type: ClusterIP
  port: 3000
  targetPort: 3000

ingress:
  enabled: true
  className: "nginx"
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
  hosts:
    - host: api.joemckenney.com
      paths:
        - path: /
          pathType: Prefix
  tls:
    - secretName: app-server-tls
      hosts:
        - api.joemckenney.com

resources:
  limits:
    cpu: 500m
    memory: 512Mi
  requests:
    cpu: 250m
    memory: 256Mi

nodeSelector: {}
tolerations: []
affinity: {}

# IMPORTANT: Fill in your production OAuth credentials
secrets:
  googleClientId: "YOUR_PROD_GOOGLE_CLIENT_ID"
  googleClientSecret: "YOUR_PROD_GOOGLE_CLIENT_SECRET"
  googleRedirectUri: "https://api.joemckenney.com/auth/google/callback"
  jwtSecret: "GENERATE_A_STRONG_SECRET_HERE"
  allowedEmail: "j.mckenney00@gmail.com"
  frontendUrl: "https://app.joemckenney.com"
  backendUrl: "https://api.joemckenney.com"
