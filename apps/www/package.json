{
  "name": "@app/www",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "pnpm run --stream --color \"/build:/\"",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build -c ./vite.server.config.ts --ssr src/entry-server.tsx --outDir dist/server",
    "build:template": "vite build -c ./vite.template.config.ts --ssr src/template.ts --outDir dist/template",
    "build:prerender": "vite build -c ./vite.prerender.config.ts",
    "build:ssg": "pnpm build:client && pnpm build:server && pnpm build:prerender && node dist/server/prerender.js",
    "build:image:local": "dbuild --image www-web",
    "deploy:k8s:local": "helm upgrade --install www-web ./helm -f ./helm/values-local.yaml --wait --timeout=5m",
    "clean": "rm -rf dist",
    "preview": "vite preview",
    "check": "biome check .",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "@vanilla-extract/css": "^1.16.2",
    "@website/synesthetic-canvas": "workspace:*",
    "@website/weather-station": "workspace:*",
    "posthog-js": "^1.297.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@mdx-js/rollup": "^3.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vanilla-extract/vite-plugin": "^4.0.18",
    "@vitejs/plugin-react": "^4.3.4",
    "@website/config": "workspace:*",
    "gray-matter": "^4.0.3",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.0.0",
    "vite": "^6.0.7"
  }
}
