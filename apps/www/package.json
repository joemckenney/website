{
  "name": "@app/www",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsgo && vite build",
    "build:image:local": "dbuild --image www-web",
    "deploy:k8s:local": "helm upgrade --install www-web ./helm -f ./helm/values-local.yaml --wait --timeout=5m",
    "clean": "rm -rf dist",
    "preview": "vite preview",
    "check": "biome check .",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "posthog-js": "^1.297.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript/native-preview": "catalog:",
    "@vanilla-extract/css": "^1.16.2",
    "@vanilla-extract/vite-plugin": "^4.0.18",
    "@vitejs/plugin-react": "^4.3.4",
    "@website/config": "workspace:*",
    "vite": "^6.0.7"
  }
}
