# Local Minikube environment values for app-client
# Copy this file to values-local.yaml and customize for your environment
replicaCount: 1

image:
  repository: localhost:5000/app-web
  tag: latest
  pullPolicy: Always  # Always pull for local dev with :latest tag

ingress:
  enabled: true
  className: "nginx"
  annotations: {}
  hosts:
    - host: app.local.com
      paths:
        - path: /
          pathType: Prefix
  tls: []

resources:
  limits:
    cpu: 200m
    memory: 128Mi
  requests:
    cpu: 100m
    memory: 64Mi
