# Example terraform.tfvars - Copy to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars with real secrets

vultr_api_key       = "YOUR_VULTR_API_KEY"
cluster_name        = "app-production"
region              = "ewr"  # New Jersey, see: https://api.vultr.com/v2/regions
kubernetes_version  = "v1.28.2+1"
node_plan           = "vc2-2c-4gb"  # 2 vCPU, 4GB RAM
node_count          = 2
enable_autoscaling  = true
min_nodes           = 2
max_nodes           = 5
enable_firewall     = true
letsencrypt_email   = "your@email.com"
