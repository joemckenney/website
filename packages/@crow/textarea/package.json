{
  "name": "@crow/textarea",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/index.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node build.mjs && tsgo --declaration --emitDeclarationOnly --outDir dist",
    "clean": "rm -rf dist",
    "check": "biome check ."
  },
  "dependencies": {
    "@crow/flex": "workspace:*",
    "@crow/text": "workspace:*",
    "@crow/theme": "workspace:*",
    "@react-aria/textfield": "^3.14.0",
    "@react-aria/utils": "^3.25.0",
    "@react-types/textfield": "^3.10.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/react": "^18.0.0",
    "@typescript/native-preview": "catalog:",
    "@vanilla-extract/css": "^1.16.0",
    "@vanilla-extract/esbuild-plugin": "^2.3.0",
    "@vanilla-extract/recipes": "^0.5.0",
    "@website/config": "workspace:*",
    "esbuild": "^0.24.0"
  }
}
