{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    // Services that generate OpenAPI specs need spec/ in outputs for cache restoration
    "@gateway/service#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "spec/**"]
    },
    "@users/service#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "spec/**"]
    },
    // Spec packages output openapi.json to their root
    "@gateway/spec#build": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json"]
    },
    "@users/spec#build": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build:docker:local": {
      "cache": false
    },
    "build:docker:prod": {
      "cache": false
    },
    "deploy:helm:local": {
      "cache": false
    },
    "deploy:helm:prod": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "clean:docker": {
      "cache": false
    }
  }
}
