{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build:docker:local": {
      "cache": false
    },
    "build:docker:prod": {
      "cache": false
    },
    "deploy:helm:local": {
      "dependsOn": ["build:docker:local"],
      "cache": false
    },
    "clean:docker": {
      "cache": false
    }
  }
}
